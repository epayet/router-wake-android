// Copy this file to:
//   app/src/main/java/com/jakspinning/wakemypc/Config.kt
// and fill in your real values. That path is gitignored (see .gitignore),
// so your FritzBox credentials never get committed.
//
// Where these values come from — see the FritzBox checklist in the README:
//  - fritzBoxHost / tr064Port: the FritzBox's LAN address, reachable once
//    your phone's WireGuard VPN is connected.
//  - fritzBoxUsername / fritzBoxPassword: the DEDICATED FritzBox user you
//    create for this app (not your main admin login).
//  - pcMacAddress: your PC's MAC address (for Wake-on-LAN).
//  - pcLanIp: your PC's LAN IP (for the status check).

package com.jakspinning.wakemypc

object Config {
    const val FRITZBOX_HOST = "fritz.box"
    const val TR064_PORT = 49000
    const val FRITZBOX_USERNAME = "your-dedicated-username"
    const val FRITZBOX_PASSWORD = "your-dedicated-password"
    const val PC_MAC_ADDRESS = "AA:BB:CC:DD:EE:FF"
    const val PC_LAN_IP = "192.168.178.42"
}

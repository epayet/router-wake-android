<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A startled little router, antennas broadcasting a wake signal. Dark
         navy line art — the background is FRITZ yellow, and white-on-yellow
         has poor contrast. -->

    <!-- Scaled down and recentered: the un-scaled artwork's antennas/feet
         reached close to the edge of the 108x108 canvas, which got clipped
         by circular/squircle adaptive-icon masks on the home screen. -->
    <group
        android:name="mascot"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:translateY="5">

        <!-- body -->
        <path
            android:fillColor="#00000000"
            android:pathData="M32,44 L76,44 A6,6 0 0 1 82,50 L82,72 A6,6 0 0 1 76,78 L32,78 A6,6 0 0 1 26,72 L26,50 A6,6 0 0 1 32,44 Z"
            android:strokeColor="#12181F"
            android:strokeWidth="6"
            android:strokeLineCap="round" />

        <!-- antennas -->
        <path
            android:fillColor="#00000000"
            android:pathData="M38,44 L30,24"
            android:strokeColor="#12181F"
            android:strokeWidth="5"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#00000000"
            android:pathData="M70,44 L78,24"
            android:strokeColor="#12181F"
            android:strokeWidth="5"
            android:strokeLineCap="round" />

        <!-- antenna tips -->
        <path
            android:fillColor="#12181F"
            android:pathData="M27,24 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
        <path
            android:fillColor="#12181F"
            android:pathData="M75,24 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />

        <!-- signal arcs (also reads as "ringing") -->
        <path
            android:fillColor="#00000000"
            android:pathData="M18,30 a12,12 0 0,1 8,-16"
            android:strokeColor="#12181F"
            android:strokeWidth="4"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#00000000"
            android:pathData="M90,30 a12,12 0 0,0 -8,-16"
            android:strokeColor="#12181F"
            android:strokeWidth="4"
            android:strokeLineCap="round" />

        <!-- feet -->
        <path
            android:fillColor="#00000000"
            android:pathData="M34,78 L28,84"
            android:strokeColor="#12181F"
            android:strokeWidth="5"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#00000000"
            android:pathData="M74,78 L80,84"
            android:strokeColor="#12181F"
            android:strokeWidth="5"
            android:strokeLineCap="round" />

        <!-- wide, startled eyes -->
        <path
            android:fillColor="#12181F"
            android:pathData="M40,57 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
        <path
            android:fillColor="#12181F"
            android:pathData="M62,57 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />

        <!-- surprised "oh!" mouth -->
        <path
            android:fillColor="#00000000"
            android:pathData="M51,66 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
            android:strokeColor="#12181F"
            android:strokeWidth="3" />

        <!-- status lights -->
        <path
            android:fillColor="#12181F"
            android:pathData="M36,73 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
        <path
            android:fillColor="#12181F"
            android:pathData="M52,73 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
        <path
            android:fillColor="#12181F"
            android:pathData="M68,73 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
    </group>
</vector>
